# ==============================================================================
# AUTOWISE AI — ENVIRONMENT CONFIGURATION & API KEYS DIRECTORY
# ==============================================================================
# This file contains configuration variables for AutoWise AI.
# To activate real external services, paste your credentials into .env.
# If credentials are not provided, AutoWise AI seamlessly operates using its
# built-in verified automotive database, NHTSA public VIN decoder, and mock adapters.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default: Local SQLite database (zero external installation required)
DATABASE_URL="file:./dev.db"
# If using PostgreSQL (Neon, Supabase, AWS RDS, local):
# DATABASE_URL="postgresql://user:password@localhost:5432/autowise_db?schema=public"

# Session & JWT Secret (Random string for authentication encryption)
JWT_SECRET="autowise_super_secret_jwt_key_2026_change_in_production"

# ------------------------------------------------------------------------------
# 2. AI PROVIDER CONFIGURATION (Choose ONE or more)
# ------------------------------------------------------------------------------
# Active AI provider: "mock", "openai", "nvidia_nim", "gemini", or "anthropic"
AI_PROVIDER="mock"

# --- Option A: OpenAI (GPT-4o, GPT-4o-mini with Vision) ---
# Where to get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Option B: NVIDIA NIM / NVIDIA API (Automotive edge or cloud NIM) ---
# Where to get key: https://build.nvidia.com/
# Direct catalog: https://build.nvidia.com/meta/llama-3.1-70b-instruct
NVIDIA_NIM_API_KEY=""
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_MODEL="meta/llama-3.1-70b-instruct"

# --- Option C: Google Gemini (Gemini 1.5 Pro / Flash with Multimodal Vision & Video) ---
# Where to get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# --- Option D: Anthropic Claude (Claude 3.5 Sonnet) ---
# Where to get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ------------------------------------------------------------------------------
# 3. VEHICLE SPECIFICATION & VIN DECODING PROVIDERS
# ------------------------------------------------------------------------------
# NHTSA vPIC Global/US VIN Decoder:
# FREE PUBLIC GOVERNMENT API — NO KEY REQUIRED!
# Docs: https://vpic.nhtsa.dot.gov/api/
ENABLE_NHTSA_VPIC="true"

# Commercial Vehicle Database (e.g. RapidAPI Car Data, AutoData, VinAudit):
# Where to get key: https://rapidapi.com/hub (Search "Car API" or "VIN Decoder")
RAPIDAPI_VEHICLE_KEY=""
RAPIDAPI_VEHICLE_HOST="car-data.p.rapidapi.com"

# ------------------------------------------------------------------------------
# 4. SPARE PARTS & MARKETPLACE PRICE COMPARISON APIS
# ------------------------------------------------------------------------------
# --- eBay Browse API ---
# Where to get key: https://developer.ebay.com/
# Create a developer account, create an App, and generate Client ID and Secret:
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_ENVIRONMENT="PRODUCTION" # or "SANDBOX"

# --- Amazon Product Advertising API (PA-API v5) ---
# Where to get key: https://affiliate-program.amazon.in/ (or amazon.com)
# Requires an active Amazon Associates / Affiliate account with PA-API access.
AMAZON_PAAPI_ACCESS_KEY=""
AMAZON_PAAPI_SECRET_KEY=""
AMAZON_PAAPI_ASSOCIATE_TAG=""
AMAZON_PAAPI_REGION="IN" # "IN" for Amazon.in, "US" for Amazon.com

# --- Google Custom Search JSON API (for searching Indian retailers e.g. Boodmo) ---
# Where to get key: https://developers.google.com/custom-search/v1/overview
# Create Custom Search Engine: https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""

# ------------------------------------------------------------------------------
# 5. STORAGE & UPLOADS
# ------------------------------------------------------------------------------
# Storage mode: "local" (saves to ./public/uploads) or "s3"
STORAGE_PROVIDER="local"
S3_BUCKET_NAME=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
